# XNutri - modelo de variáveis para Production na Vercel.
# Preencha no painel Vercel > Project > Settings > Environment Variables.
# Nunca envie um arquivo preenchido para o GitHub.

NODE_ENV=production
XNUTRI_DEPLOYMENT=production

# Domínio público HTTPS. Use exatamente o mesmo endereço nas três variáveis.
NEXT_PUBLIC_APP_URL=https://seu-dominio.com.br
AUTH_URL=https://seu-dominio.com.br
NEXTAUTH_URL=https://seu-dominio.com.br
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_SESSION_MAX_AGE_SECONDS=28800

# PostgreSQL online. No Neon, DATABASE_URL usa pooler e DIRECT_URL usa conexão direta.
DATABASE_URL=
DIRECT_URL=
DATABASE_POOL_MAX=2
PRISMA_LOG_ERRORS=false

# PagBank Checkout hospedado. Tokens são sempre secretos: não use NEXT_PUBLIC_.
PAGBANK_ENVIRONMENT=production
PAGBANK_TOKEN=
PAGBANK_WEBHOOK_TOKEN=
CRON_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=xnutri

# Correios (opcional enquanto a integração oficial não estiver ativa)
CORREIOS_USER=
CORREIOS_PASSWORD=
CORREIOS_TOKEN=
CORREIOS_CARTAO_POSTAGEM=
CORREIOS_CONTRATO=
CORREIOS_DR=

# Loja e PDV
NEXT_PUBLIC_STORE_NAME=XNutri
NEXT_PUBLIC_STORE_CITY=Mirassol
NEXT_PUBLIC_STORE_STATE=SP
NEXT_PUBLIC_PDV_ENABLED=true
PDV_RECEIPT_FOOTER=Obrigado por comprar na XNutri Mirassol.
PDV_ALLOW_NEGATIVE_STOCK=false
PDV_CASHIER_MAX_DISCOUNT_PERCENT=10
NEXT_PUBLIC_PWA_NAME=XNutri Mirassol
NEXT_PUBLIC_PWA_SHORT_NAME=XNutri
